{
  "manifest_version": 3,
  "name": "POWER 2.0 - Ultimate Job Application Engine",
  "version": "2.0.0",
  "description": "CV tailoring + Autofill + Workday automation. 95%+ ATS match.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/modules/mandatory-keywords.js",
        "content/modules/universal-jd-parser.js",
        "content/modules/reliable-extractor.js",
        "content/modules/keyword-strategy.js",
        "content/modules/cv-engine.js",
        "content/modules/tailor-engine.js",
        "content/modules/validation-engine.js",
        "content/modules/score-engine.js",
        "content/modules/turbo-pipeline.js",
        "content/modules/location-strategy.js",
        "content/modules/pdf-generator.js",
        "content/modules/file-attacher.js",
        "content/modules/autofill-engine.js",
        "content/modules/saved-responses.js",
        "content/workday/workday-controller.js",
        "content/workday/workday-pages.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "content/*.css"],
      "matches": ["<all_urls>"]
    }
  ]
}